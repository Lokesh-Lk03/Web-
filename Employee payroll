from tkinter import *

root = Tk()
root.title("Play Roll System")
root.geometry("500x700")

def click():
    Salary = int(e3.get())

    bonus = Salary * 20 / 100
    Overtime = Salary * 10 / 100
    TravelAllowance = Salary * 5 / 100
    gross = Salary + bonus + Overtime + TravelAllowance

    e4.delete(0, END)
    e4.insert(0, str(bonus))
    e5.delete(0, END)
    e5.insert(0, str(Overtime))
    e6.delete(0, END)
    e6.insert(0, str(TravelAllowance))
    e7.delete(0, END)
    e7.insert(0, str(gross))

    return

