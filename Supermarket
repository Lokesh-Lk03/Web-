from tkinter import*
root=Tk()
root.title("super market")
root.geometry("500x700")
def click():
    a=int(e3.get())
    b=int(e4.get())
    total=a*b
    gst=total*10/100
    paid = gst+total
    e5.delete(0,END)
    e5.insert(0,str(total))
    e6.delete(0,END)
    e6.insert(0,str(gst))
    e7.delete(0,END)
    e7.insert(0,str(paid))
    return
f1=Frame(root)
