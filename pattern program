print("-------------------")
n=int(input("Enter the number:"))
for i in range(n):
 for j in range(n):
 print("*",end=" ")
 print()

print("Diamond Pattern")
print("---------------")
n = int(input("Enter the number of rows: "))
for i in range(1, n + 1):
 print(" " * (n - i) + "*" * (2 * i - 1))
for i in range(n - 1, 0, -1):
 print(" " * (n - i) + "*" * (2 * i - 1))

print("Right Arrow Pattern")
print("---------------")
n = int(input("Enter the number of rows: "))
for i in range(1, n + 1):
 print(" " * (i - 1) + "*" * n)
for i in range(n - 1, 0, -1):
 print(" " * (i-1) + "*" * n)

print("Left Arrow Pattern")
print("---------------")
n = int(input("Enter the number of rows: "))
for i in range(1, n + 1):
 print(" " * (n-i) + "*" * n)
for i in range(n - 1, 0, -1):
 print(" " * (n-i) + "*" * n)

print("Triangle Pattern")
print("-------------------")
n=int(input("Enter the number:"))
for i in range(1,n+1):
 for j in range(i):
 print("*",end=" ")
 print()
