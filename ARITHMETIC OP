
from tkinter import *
root=Tk()
root.title("simple calculator")
root.geometry("500x700")

def add():
    a=int(e1.get())
    b=int(e2.get())
    add=a+b
    e3.delete(0,END)
    e3.insert(0,str(add))
    return
def sub():
    a=int(e1.get())
    b=int(e2.get())
    sub=a-b
    e3.delete(0,END)
    e3.insert(0,str(sub))
    return
def mul():
    a=int(e1.get())
    b=int(e2.get())
    mul=a*b
    e3.delete(0,END)
    e3.insert(0,str(mul))
    return
def div():
    a=int(e1.get())
    b=int(e2.get())
    div=a/b
    e3.delete(0,END)
    e3.insert(0,str(div))
    return
def mod():
    a=int(e1.get())
    b=int(e2.get())
    mod=a%b
    e3.delete(0,END)
    e3.insert(0,str(mod))
    return
    
f1=Frame(root)
