from tkinter import *
root=Tk()
root.title("Eb bill")
root.geometry("500x700")
def click():
     a=e3.get()
     b=e4.get()
     tot=int(b)-int(a)
     unit=tot*5
     e5.delete(0,END)
     e5.insert(0,str(tot))
     e6.delete(0,END)
     e6.insert(0,str(unit))
     return
f1=Frame(root)
f1.config(bg="LEMON CHIFFON")
f1.pack(fill="both",expand=0)
l1=Label(f1,text="GOVERNMENT OF TAMILNADU",bg="LEMON CHIFFON",fg="BLACK",font=("arial",18,"bold"))
l1.pack()
l2=Label(f1,text="ELECTRICITY BOARD",bg="LEMON CHIFFON",fg="BLACK",font=("arial",14,"bold"))
l2.pack()

f2=Frame(root)
f2.config(bg="LIGHTBLUE1")
f2.pack(fill="both",expand=0)

l3=Label(f2,text="EB NUMBER",bg="LIGHTBLUE1")
l3.pack()
e1=Entry(f2)
e1.pack()

l4=Label(f2,text="CUSTOMER NAME",bg="LIGHTBLUE1")
l4.pack()
e2=Entry(f2)
e2.pack()

l5=Label(f2,text="PREVIOUS UNIT",bg="LIGHTBLUE1")
l5.pack()
e3=Entry(f2)
e3.pack()

l6=Label(f2,text="CURRENT UNIT",bg="LIGHTBLUE1")
l6.pack()
e4=Entry(f2)
e4.pack()

l7=Label(f2,text="UNIT USED THIS MONTH",bg="LIGHTBLUE1")
l7.pack()
e5=Entry(f2)
e5.pack()

l8=Label(f2,text="AMOUNT TO BE PAID",bg="LIGHTBLUE1")
l8.pack()
e6=Entry(f2)
e6.pack()
b1=Button(f2,text="CLICK",command=click)
b1.pack()
root.mainloop()                
    
